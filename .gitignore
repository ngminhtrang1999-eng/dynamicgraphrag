# Thesis drafts, proposals, slides: private. Only the dataset statistics tool is public.
thesis/**
!thesis/**/
!thesis/thesis-template-clean/tools/dataset_stats.py

# Evaluation outputs: only scripts, aggregate numbers and ID+label files are public.
# Per-sentence outputs with source/reference/translation text stay local.
evaluation/**
!evaluation/**/
!evaluation/*.py
!evaluation/*_summary.csv
!evaluation/*_overall_results.csv
!evaluation/bleurt-20/*.csv
!evaluation/comet/*.csv
!evaluation/comet_qe/*.csv
!evaluation/m-eta/*.csv
!evaluation/analysis/*.py
!evaluation/analysis/*.csv
!evaluation/objective_metrics/*/_summary.csv
!evaluation/objective_metrics/*/_aggregate.csv
evaluation/objective_metrics/_test_*/
!evaluation/human_eval/README.md
!evaluation/human_eval/human_eval_key.csv
